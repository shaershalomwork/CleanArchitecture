<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DataCentric.Integration.Solution.Template</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageType>Template</PackageType>
    <Title>Data-Centric Integration Solution Template</Title>
    <Authors>Data-centric baseline maintainers</Authors>
    <Description>Integration baseline derived from Jason Taylor's Clean Architecture.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- These scripts are template content, never NuGet installation hooks. -->
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../**/*"
      Exclude="../artifacts/**;../.git/**;../.github/**;../.agents/**;../.codex/**;../**/node_modules/**;../**/bin/**;../**/obj/**;../**/dist/**;../**/build/**;../**/.angular/**;../.devcontainer/**;../.aspire/**;../README.md;../CODE_OF_CONDUCT.md;../CleanArchitecture.nuspec;../renovate.json;../build/**;../src/Web/wwwroot/openapi/**;../src/Web/ClientApp/src/app/web-api-client.ts;../**/*.user;../**/*.pfx;../**/*.db"
      Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Remove="../**/TestResults/**" />
    <Content Remove="../.vs/**;../**/screenshots/**;../**/coverage/**" />
    <Content Include="../README.md" Pack="true" PackagePath="/" />
    <Content Include="build.ps1;verify.ps1" Pack="true" PackagePath="content/build/" />
  </ItemGroup>
</Project>
